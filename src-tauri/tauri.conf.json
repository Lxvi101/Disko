{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disko",
  "version": "0.2.0",
  "identifier": "app.disko",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Disko",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "backgroundColor": "#0b0d14",
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utilities",
    "shortDescription": "Disk space visualizer with a Codex-powered cleanup assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RDNFM0EwQzAwQTc3N0YKUldSL2R3ckFvT1BUZCtIMnBSWjlRU2pyUmxoS2ZDR3FGdmJ4eXJoNExuNSt6dGdscHJnMXdiRmwK",
      "endpoints": [
        "https://github.com/Lxvi101/Disko/releases/latest/download/latest.json"
      ]
    }
  }
}
